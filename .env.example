# Скопируй в .env и заполни:  cp .env.example .env
# Файл .env никогда не коммитится (см. .gitignore).

# Токен бота из @BotFather. Старый утёкший токен отзови командой /revoke!
BOT_TOKEN=PASTE_NEW_TOKEN_HERE

# Твой Telegram ID (администратор).
ADMIN_ID=1398491942

# Мастер-ключ шифрования анкет (AES-256-GCM). Сгенерируй и сохрани в тайне:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Без него зашифрованные данные восстановить невозможно.
MASTER_KEY=

# Путь к базе SQLite (не коммитить).
DB_PATH=dating.sqlite3
